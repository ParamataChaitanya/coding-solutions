#include <bits/stdc++.h>
using namespace std;
int main() {
    int T;
    cin>>T;
    while (T--) {
        int N;
        cin>>N;
        string A,B;
        cin>>A>>B;
        int onesA=0,onesB=0;
        for(char c:A)
        {
            onesA+=(c=='1');
        }
        for(char c:B)
        {
            onesB+=(c=='1');
        }
        if((onesA%2)==(onesB%2))
        {
            cout<<"YES\n";
        }
        else
        {
            cout<<"NO\n";
        }
    }
}
#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while(t--)
	{
	    int n;
	    cin>>n;
	    string a,b;
	    cin>>a>>b;
	    int c1 = count(a.begin(), a.end(), 'a');
	    int c2 = count(b.begin(), b.end(), 'b');
	    if (c1==c2) 
	    {
	        cout << "YES\n";
	    } 
	    else 
	    {
	        cout << "NO\n";
	    }
	}

}

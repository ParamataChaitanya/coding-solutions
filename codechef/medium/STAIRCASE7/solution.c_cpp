#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while(t--)
	{
	    int n;
	    cin>>n;
	    vector<int>a(n);
	    for(int i=0;i<n;i++)
	    {
	        cin>>a[i];
	    }
	    unordered_map<int,int>c;
	    int m=0;
	    for(int i=0;i<n;i++)
	    {
	        int j=a[i]-i;
	        c[j]++;
	        m=max(m,c[j]);
	    }
	    cout<<n-m<<endl;
	}

}

#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while(t--)
	{
	    int n,m,k;
	    cin>>n>>m>>k;
	    vector<int>a(n);
	    vector<int>b(n+1,0);
	    for(int i=0;i<m;i++)
	    {
	        cin>>a[i];
	        b[a[i]]=1;
	    }
	    int c=0;
	    for(int i=1;i<=n;i++)
	    {
	        if(!b[i])
	        {
	            cout<<i<<" ";
	            c++;
	        }
	        if(c==k)
	        {
	            break;
	        }
	    }
	    cout<<endl;
	}

}
